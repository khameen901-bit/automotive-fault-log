import androidx.compose.ui.unit.dp
import androidx.navigation.NavController
import com.khameen901.automotivefaultlog.domain.model.FaultFormData
import com.khameen901.automotivefaultlog.utils.ImageStorage
import com.khameen901.automotivefaultlog.viewmodel.FaultViewModel

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun AddEditFaultScreen(
    navController: NavController,
    viewModel: FaultViewModel,
    faultId: Long = 0L
) {
    val context = LocalContext.current
    val selectedFault by viewModel.selectedFault.collectAsState()
    var form by remember { mutableStateOf(FaultFormData()) }
    var imagePaths by remember { mutableStateOf(listOf<String>()) }

    val pickImagesLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.PickMultipleVisualMedia(maxItems = 10)
    ) { uris: List<Uri> ->
        val copiedPaths = uris.mapNotNull { ImageStorage.copyUriToAppStorage(context, it) }
        imagePaths = (imagePaths + copiedPaths).distinct()
        form = form.copy(imagePaths = imagePaths)
    }

    LaunchedEffect(faultId) {
        if (faultId > 0L) {
            viewModel.getFaultById(faultId)
        }
    }

    LaunchedEffect(selectedFault) {
        val detail = selectedFault ?: return@LaunchedEffect
        val vehicle = detail.vehicle
        form = FaultFormData(
            id = detail.faultRecord.id,
            vehicleId = vehicle?.id ?: 0L,
            manufacturer = vehicle?.manufacturer.orEmpty(),
            model = vehicle?.model.orEmpty(),
            productionYear = vehicle?.productionYear ?: 0,
            fuelType = vehicle?.fuelType.orEmpty(),
            engineType = vehicle?.engineType.orEmpty(),
            engineDisplacement = vehicle?.engineDisplacement.orEmpty(),
            cylinderCount = vehicle?.cylinderCount.orEmpty(),
            engineCode = vehicle?.engineCode.orEmpty(),
            transmissionType = vehicle?.transmissionType.orEmpty(),
            drivetrain = vehicle?.drivetrain.orEmpty(),
            vin = vehicle?.vin.orEmpty(),
            customerComplaint = detail.faultRecord.customerComplaint,
            symptoms = detail.faultRecord.symptoms,
            dtcCodes = detail.dtcCodes.map { it.code },
            controlModule = detail.faultRecord.controlModule,
            faultStatus = detail.faultRecord.faultStatus,
            freezeFrame = detail.faultRecord.freezeFrame,
            diagnosticTests = detail.diagnosticTests.map { it.name },
            electricalMeasurements = detail.faultRecord.electricalMeasurements,
            testedComponents = detail.faultRecord.testedComponents,
            suspectedCause = detail.faultRecord.suspectedCause,
            confirmedRootCause = detail.faultRecord.confirmedRootCause,
            repairProcedure = detail.faultRecord.repairProcedure,
            finalVerificationResult = detail.faultRecord.finalVerificationResult,
            notes = detail.faultRecord.notes,
            recordingDate = detail.faultRecord.recordingDate,
            imagePaths = detail.images.map { it.filePath }
        )
        imagePaths = detail.images.map { it.filePath }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text(if (faultId > 0L) "تعديل حالة العطل" else "إضافة حالة عطل جديدة") },
                navigationIcon = {
                    IconButton(onClick = { navController.popBackStack() }) {
                        Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
                    }
                }
            )
        }
    ) { paddingValues ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .background(MaterialTheme.colorScheme.background)
                .padding(paddingValues)
                .padding(horizontal = 16.dp, vertical = 12.dp)
                .verticalScroll(rememberScrollState()),
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)
            ) {
                Column(
                    modifier = Modifier.padding(16.dp),
                    verticalArrangement = Arrangement.spacedBy(12.dp)
                ) {
                    Text("بيانات السيارة")
                    Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                        OutlinedTextField(value = form.manufacturer, onValueChange = { form = form.copy(manufacturer = it) }, label = { Text("الشركة المصنعة") }, modifier = Modifier.weight(1f))
                        OutlinedTextField(value = form.model, onValueChange = { form = form.copy(model = it) }, label = { Text("الموديل") }, modifier = Modifier.weight(1f))
                    }
                    Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                        OutlinedTextField(value = form.productionYear.toString(), onValueChange = { form = form.copy(productionYear = it.toIntOrNull() ?: 0) }, label = { Text("سنة الإنتاج") }, modifier = Modifier.weight(1f))
                        OutlinedTextField(value = form.fuelType, onValueChange = { form = form.copy(fuelType = it) }, label = { Text("نوع الوقود") }, modifier = Modifier.weight(1f))
                    }
                    Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                        OutlinedTextField(value = form.engineType, onValueChange = { form = form.copy(engineType = it) }, label = { Text("نوع المحرك") }, modifier = Modifier.weight(1f))
                        OutlinedTextField(value = form.engineDisplacement, onValueChange = { form = form.copy(engineDisplacement = it) }, label = { Text("سعة المحرك") }, modifier = Modifier.weight(1f))
                    }
                    Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                        OutlinedTextField(value = form.cylinderCount, onValueChange = { form = form.copy(cylinderCount = it) }, label = { Text("عدد الأسطوانات") }, modifier = Modifier.weight(1f))
                        OutlinedTextField(value = form.engineCode, onValueChange = { form = form.copy(engineCode = it) }, label = { Text("رمز المحرك") }, modifier = Modifier.weight(1f))
                    }
                    Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                        OutlinedTextField(value = form.transmissionType, onValueChange = { form = form.copy(transmissionType = it) }, label = { Text("نوع ناقل الحركة") }, modifier = Modifier.weight(1f))
                        OutlinedTextField(value = form.drivetrain, onValueChange = { form = form.copy(drivetrain = it) }, label = { Text("نوع الدفع") }, modifier = Modifier.weight(1f))
                    }
                    OutlinedTextField(value = form.vin, onValueChange = { form = form.copy(vin = it) }, label = { Text("VIN") }, modifier = Modifier.fillMaxWidth())
                }
            }

            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)
            ) {
                Column(
                    modifier = Modifier.padding(16.dp),
                    verticalArrangement = Arrangement.spacedBy(12.dp)
                ) {
                    Text("معلومات العطل")
                    OutlinedTextField(value = form.customerComplaint, onValueChange = { form = form.copy(customerComplaint = it) }, label = { Text("شكوى العميل") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.symptoms, onValueChange = { form = form.copy(symptoms = it) }, label = { Text("الأعراض") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.dtcCodes.joinToString(", "), onValueChange = { form = form.copy(dtcCodes = it.split(',').map { code -> code.trim() }.filter { it.isNotBlank() }) }, label = { Text("رموز DTC") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.controlModule, onValueChange = { form = form.copy(controlModule = it) }, label = { Text("وحدة التحكم") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.faultStatus, onValueChange = { form = form.copy(faultStatus = it) }, label = { Text("حالة العطل") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.freezeFrame, onValueChange = { form = form.copy(freezeFrame = it) }, label = { Text("Freeze Frame") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.diagnosticTests.joinToString(", "), onValueChange = { form = form.copy(diagnosticTests = it.split(',').map { test -> test.trim() }.filter { it.isNotBlank() }) }, label = { Text("الاختبارات التشخ��صية") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.electricalMeasurements, onValueChange = { form = form.copy(electricalMeasurements = it) }, label = { Text("القياسات الكهربائية") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.testedComponents, onValueChange = { form = form.copy(testedComponents = it) }, label = { Text("المكونات المختبرة") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.suspectedCause, onValueChange = { form = form.copy(suspectedCause = it) }, label = { Text("السبب المشتبه") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.confirmedRootCause, onValueChange = { form = form.copy(confirmedRootCause = it) }, label = { Text("السبب الجذري المؤكد") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.repairProcedure, onValueChange = { form = form.copy(repairProcedure = it) }, label = { Text("إجراءات الإصلاح") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.finalVerificationResult, onValueChange = { form = form.copy(finalVerificationResult = it) }, label = { Text("نتيجة التحقق النهائية") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(value = form.notes, onValueChange = { form = form.copy(notes = it) }, label = { Text("ملاحظات") }, modifier = Modifier.fillMaxWidth())
                }
            }

            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)
            ) {
                Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
                    Button(
                        onClick = { pickImagesLauncher.launch(PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly)) },
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Text("إضافة صور متعددة")
                    }
                    if (imagePaths.isNotEmpty()) {
                        Text("الصور الحالية")
                        imagePaths.forEach { path ->
                            Row(horizontalArrangement = Arrangement.SpaceBetween, modifier = Modifier.fillMaxWidth()) {
                                Text(path.substringAfterLast('/'))
                                IconButton(onClick = {
                                    imagePaths = imagePaths.filterNot { it == path }
                                    form = form.copy(imagePaths = imagePaths)
                                    ImageStorage.deleteImageFile(path)
                                }) {
                                    Icon(Icons.Default.Delete, contentDescription = "Delete")
                                }
                            }
                        }
                    }
                }
            }

            Button(
                onClick = {
                    viewModel.saveFault(form.copy(imagePaths = imagePaths))
                    navController.popBackStack()
                },
                modifier = Modifier.fillMaxWidth()
            ) {
                Text("حفظ السجل")
            }
        }
    }
}

